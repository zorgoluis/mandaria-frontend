          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "caseRevision": {
          "type": "string"
        },
        "materialRevision": {
          "type": "string"
        },
        "commandsEnabled": {
          "type": "boolean"
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "nextPageToken": {
          "type": ["string", "null"]
        },
        "section": {
          "type": "string",
          "const": "evidence-sources"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": ["VERIFIED_CONTACT_NOTE", "EXISTING_INTERNAL_RECORD"]
              },
              "sourceRef": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "CONTACT_VERIFICATION_NOTE",
                      "ASSIGNMENT",
                      "EXECUTION_EVENT",
                      "CUSTODY_RESOLUTION",
                      "SHIPPING_DECLARATION",
                      "COMMAND_RECEIPT"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": ["type", "id", "sha256"],
                "additionalProperties": false
              },
              "partyId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["id", "kind", "sourceRef", "partyId"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "caseId",
        "caseRevision",
        "materialRevision",
        "commandsEnabled",
        "asOf",
        "nextPageToken",
        "section",
        "items"
      ],
      "additionalProperties": false
    }
  ]
}
