VITE_API_URL=http://localhost:3000
# Opcional. Clave Web pública restringida; configurar privadamente en .env.local/build.
VITE_GOOGLE_MAPS_API_KEY=
# Activar sólo con un backend que acepte stopAddresses en precotizaciones de cliente.
VITE_PREQUOTE_STOP_ADDRESSES=false
# Publicación: VITE_API_URL=https://mandaria.com.mx
# Sólo el origen: el cliente añade /api/v1 para todas las llamadas.
